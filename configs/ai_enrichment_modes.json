{
  "version": "2026.10-SSOT",
  "description": "Zero-External-LLM In-Session Subagent AI Enrichment Strategy (SSOT)",
  "policy": {
    "external_gemini_api": "DISABLED",
    "external_openrouter_api": "DISABLED",
    "external_fallback_cascade": "DISABLED",
    "cost_per_item": "$0.00"
  },
  "canonical_engine": {
    "provider": "antigravity_in_session_subagents",
    "model": "flash",
    "batch_size": 25,
    "concurrency": "parallel_wave_x3",
    "queue_directory": "data/subagent_queue/",
    "notes": "100% In-Session Subagents only. Zero external REST API calls, zero 404/429 errors, zero sub-chatting windows."
  },
  "scheduled_automation": {
    "trigger": "antigravity_native_cron",
    "cadence": "CRON_TZ=Asia/Seoul 0 11,23 * * *",
    "task_id": "task-1551",
    "scope": "in_session_notification_only"
  },
  "post_enrichment_pipeline": {
    "step_1": "python tools/drain_voyage_embeddings.py",
    "step_2": "python tools/recompute_spike_scores.py --commit"
  }
}
